server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types application/javascript application/json text/css text/plain image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        # HTML and unversioned assets must discover the next deployment.
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }

    # The build embeds a content hash in these filenames. Only successful
    # responses get the long cache lifetime; a missing asset must remain a 404.
    location ~* "^/static/.+\.[0-9a-f]{8,}\.[a-z0-9.]+$" {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location /static/ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location /elasticsearch/$ELASTICSEARCH_INDEX/_search {
        proxy_set_header                Authorization "Basic $ELASTICSEARCH_AUTHORIZATION";
        proxy_pass                      $ELASTICSEARCH_URL/$ELASTICSEARCH_INDEX/_search;

        # Set a timeout for Elasticsearch queries
        proxy_read_timeout 30s;
        proxy_connect_timeout 30s;

        # Limit request body size to prevent enormous queries
        client_max_body_size 1M;
    }

    location /elasticsearch/$ELASTICSEARCH_INDEX/_count {
        proxy_set_header                Authorization "Basic $ELASTICSEARCH_AUTHORIZATION";
        proxy_pass                      $ELASTICSEARCH_URL/$ELASTICSEARCH_INDEX/_count;

        # Set a timeout for Elasticsearch queries
        proxy_read_timeout 30s;
        proxy_connect_timeout 30s;

        # Limit request body size to prevent enormous queries
        client_max_body_size 1M;
    }

    location /openai/v1/embeddings {
        proxy_set_header                Authorization "Bearer $OPENAI_API_KEY";
        proxy_pass                      $OPENAI_URL/v1/embeddings;
    }
}
