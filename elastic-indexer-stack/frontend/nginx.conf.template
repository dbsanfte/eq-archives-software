server {
    listen 8080;
    server_name localhost;
    root /usr/share/nginx/html;
    include /etc/nginx/security-headers.conf;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types application/javascript application/json text/css text/plain image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        # HTML and unversioned assets must discover the next deployment.
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }

    # The build embeds a content hash in these filenames. Only successful
    # responses get the long cache lifetime; a missing asset must remain a 404.
    location ~* "^/static/.+\.[0-9a-f]{8,}\.[a-z0-9.]+$" {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location /static/ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location = /elasticsearch/$ELASTICSEARCH_INDEX/_rerank {
        if ($request_method != POST) { return 405; }
        proxy_pass $SEARCH_API_URL;
    }
    location = /elasticsearch/$ELASTICSEARCH_INDEX/_search {
        if ($request_method != POST) { return 405; }
        proxy_pass $SEARCH_API_URL;
    }
    location = /elasticsearch/$ELASTICSEARCH_INDEX/_count {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        proxy_pass $SEARCH_API_URL;
    }
    location = /openai/v1/embeddings {
        if ($request_method != POST) { return 405; }
        proxy_pass $SEARCH_API_URL;
    }
    location /elasticsearch/ { return 404; }
    location /openai/ { return 404; }
}
