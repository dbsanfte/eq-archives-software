{
  "$id": "https://example.com/person.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Response",
  "type": "object",
  "properties": {
    "llm_summary": {
      "type": "string",
      "description": "The content summary."
    },
    "llm_content_flavour": {
      "type": "string",
      "enum": [
        "Game Screenshot",
        "Item Stats",
        "Monster",
        "Player Character Portrait",
        "Other"
      ],
      "pattern": "^(?!\\\\s*$).+",
      "description": "The content flavour."
    },
    "llm_image_text": {
      "type": "array",
      "description": "Any text strings found in the image.",
      "items": {
        "type": "string"
      }
    },
    "llm_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "uniqueItems": true,
        "pattern": "^[^\\\\s]+$",
        "description": "A single word with no spaces"
      },
      "description": "Content tags associated with the text."
    }
  }
}