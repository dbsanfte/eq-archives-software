{
    "$id": "https://example.com/person.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Response",
    "type": "object",
    "properties": {
        "llm_content_flavour": {
            "type": "string",
            "enum": [
                "Game Screenshot",
                "Item Stats",
                "Monster",
                "Player Character Portrait",
                "Other"
            ],
            "pattern": "^(?!\\\\s*$).+",
            "description": "The content flavour."
        }
    }
}