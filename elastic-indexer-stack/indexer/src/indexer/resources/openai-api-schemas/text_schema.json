{
  "$id": "https://example.com/person.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Response",
  "type": "object",
  "properties": {
    "llm_summary": {
      "type": "string",
      "description": "The content summary."
    },
    "llm_content_flavour": {
      "type": "string",
      "enum": [
        "Mailing List Email",
        "Newsgroup Post",
        "Forum Post",
        "Game News",
        "Zone Information",
        "Item Information",
        "Spell Information",
        "PvP Information",
        "Monster Information",
        "Strategy Guide",
        "Player Character Profile",
        "Guild Achievements",
        "Tradeskill Information",
        "Other"
      ],
      "pattern": "^(?!\\\\s*$).+",
      "description": "The content flavour."
    },
    "llm_guessed_date": {
      "type": "string",
      "format": "date",
      "description": "Best guess as to the date of the text in format YYYY-MM-DD."
    },
    "llm_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "nerf",
          "patch",
          "exploit",
          "bug",
          "guide",
          "lore",
          "event",
          "pvp",
          "raid",
          "quest",
          "drama",
          "item",
          "spell",
          "tradeskill",
          "showeq",
          "class-balance",
          "forum",
          "class-site"
        ],
        "pattern": "^[^\\\\s]+$",
        "description": "A single word with no spaces from a predefined list."
      },
      "description": "Content tags associated with the text."
    }
  }
}