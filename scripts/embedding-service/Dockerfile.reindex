# Checkpoint-preserving update of the exact verified predecessor image.
# Coalesce source copies to avoid exhausting OverlayFS depth during handoffs.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY scripts/embedding-service/image-requirements.txt \
    elastic-indexer-stack/indexer/src/reindex_text.py \
    elastic-indexer-stack/indexer/src/reindex_embeddings.py \
    elastic-indexer-stack/indexer/src/index_images.py \
    elastic-indexer-stack/indexer/src/index_websites.py \
    elastic-indexer-stack/indexer/src/indexer/openai_manager.py \
    elastic-indexer-stack/indexer/src/indexer/reindex_preparation.py \
    elastic-indexer-stack/indexer/src/indexer/gemma.py \
    elastic-indexer-stack/indexer/src/indexer/chunking.py \
    elastic-indexer-stack/indexer/src/indexer/es_manager.py \
    elastic-indexer-stack/indexer/src/indexer/es_serialization.py \
    elastic-indexer-stack/indexer/src/indexer/vector_json.py \
    elastic-indexer-stack/indexer/src/indexer/passages.py \
    elastic-indexer-stack/indexer/src/indexer/passage_forums.py \
    elastic-indexer-stack/indexer/src/indexer/image_embeddings.py \
    elastic-indexer-stack/indexer/src/indexer/archive_images.py \
    elastic-indexer-stack/indexer/src/indexer/text_handler.py \
    elastic-indexer-stack/indexer/src/indexer/image_handler.py \
    elastic-indexer-stack/indexer/src/indexer/other_handler.py \
    elastic-indexer-stack/indexer/src/indexer/source_encoding.py \
    elastic-indexer-stack/indexer/src/indexer/html_extraction.py /updates/
RUN cp /updates/image-requirements.txt /app/image-requirements.txt && \
    pip install --no-cache-dir --require-hashes -r /app/image-requirements.txt && \
    for update_source in /updates/*.py; do \
      update_name=${update_source##*/}; \
      case "$update_name" in \
        reindex_text.py|reindex_embeddings.py|index_images.py|index_websites.py) update_target=/app/src/$update_name ;; \
        *) update_target=/app/src/indexer/$update_name ;; \
      esac; \
      cp "$update_source" "$update_target" && \
      python -m compileall -b -f -o 2 "$update_target" && rm "$update_target" || exit 1; \
    done && \
    python -m indexer.gemma --download-tokenizer /opt/eqarchives/gemma-tokenizer.json && \
    rm -rf /updates
