[Unit]
Description=EQ Archives private experimental Qwen reranker
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/eqarchives-reranker/service.py start
ExecStop=/usr/bin/docker stop --time 30 eqarchives-reranker-pilot
Restart=on-failure
RestartSec=10
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
