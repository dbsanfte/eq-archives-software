[Unit]
Description=EQ Archives private CUDA reranker forward
After=network-online.target k3s.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=dbsanfte
ExecStart=/usr/bin/ssh -F /dev/null -N -T -o BatchMode=yes -o ExitOnForwardFailure=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/eqarchives-reranker-tunnel/known_hosts -o GlobalKnownHostsFile=/dev/null -o ServerAliveInterval=15 -o ServerAliveCountMax=2 -o ConnectTimeout=10 -o LogLevel=ERROR -i /etc/eqarchives-reranker-tunnel/identity -L 10.42.0.1:8083:127.0.0.1:8083 dbsanfte@192.168.68.108
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
